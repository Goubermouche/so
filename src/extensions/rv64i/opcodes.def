	X(Subw,  "subw",  InstructionShape_RRR, 0) \
	X(Sllw,  "sllw",  InstructionShape_RRR, 0) \
	X(Srlw,  "srlw",  InstructionShape_RRR, 0) \
	X(Sraw,  "sraw",  InstructionShape_RRR, 0)
