#define ExtensionsRV32MOpcodes(X)              \
	X(Mul,    "mul",    InstructionShape_RRR, 1) \
	X(Mulh,   "mulh",   InstructionShape_RRR, 1) \
	X(Mulhsu, "mulhsu", InstructionShape_RRR, 0) \
	X(Mulhu,  "mulhu",  InstructionShape_RRR, 1) \
	X(Div,    "div",    InstructionShape_RRR, 0) \
	X(Divu,   "divu",   InstructionShape_RRR, 0) \
	X(Rem,    "rem",    InstructionShape_RRR, 0) \
	X(Remu,   "remu",   InstructionShape_RRR, 0)
