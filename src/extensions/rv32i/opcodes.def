#define EXT_RV32I_OPCODES(X)      \
	X(ADD,   "add",   SHAPE_RRR, 1) \
	X(SUB,   "sub",   SHAPE_RRR, 0) \
	X(SLL,   "sll",   SHAPE_RRR, 0) \
	X(SLT,   "slt",   SHAPE_RRR, 0) \
	X(SLTU,  "sltu",  SHAPE_RRR, 0) \
	X(XOR,   "xor",   SHAPE_RRR, 1) \
	X(SRL,   "srl",   SHAPE_RRR, 0) \
	X(SRA,   "sra",   SHAPE_RRR, 0) \
	X(OR,    "or",    SHAPE_RRR, 1) \
	X(AND,   "and",   SHAPE_RRR, 1) \
	X(ADDI,  "addi",  SHAPE_RRI, 0) \
	X(SLTI,  "slti",  SHAPE_RRI, 0) \
	X(SLTIU, "sltiu", SHAPE_RRI, 0) \
	X(XORI,  "xori",  SHAPE_RRI, 0) \
	X(ORI,   "ori",   SHAPE_RRI, 0) \
	X(ANDI,  "andi",  SHAPE_RRI, 0) \
	X(SLLI,  "slli",  SHAPE_RRI, 0) \
	X(SRLI,  "srli",  SHAPE_RRI, 0) \
	X(SRAI,  "srai",  SHAPE_RRI, 0) \
	X(LUI,   "lui",   SHAPE_RI,  0)
