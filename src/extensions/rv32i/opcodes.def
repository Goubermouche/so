#define ExtensionsRV32IOpcodes(X)            \
	X(Add,   "add",   InstructionShape_RRR, 1) \
	X(Sub,   "sub",   InstructionShape_RRR, 0) \
	X(Sll,   "sll",   InstructionShape_RRR, 0) \
	X(Slt,   "slt",   InstructionShape_RRR, 0) \
	X(Sltu,  "sltu",  InstructionShape_RRR, 0) \
	X(Xor,   "xor",   InstructionShape_RRR, 1) \
	X(Srl,   "srl",   InstructionShape_RRR, 0) \
	X(Sra,   "sra",   InstructionShape_RRR, 0) \
	X(Or,    "or",    InstructionShape_RRR, 1) \
	X(And,   "and",   InstructionShape_RRR, 1) \
	X(Addi,  "addi",  InstructionShape_RRI, 0) \
	X(Slti,  "slti",  InstructionShape_RRI, 0) \
	X(Sltiu, "sltiu", InstructionShape_RRI, 0) \
	X(Xori,  "xori",  InstructionShape_RRI, 0) \
	X(Ori,   "ori",   InstructionShape_RRI, 0) \
	X(Andi,  "andi",  InstructionShape_RRI, 0) \
	X(Slli,  "slli",  InstructionShape_RRI, 0) \
	X(Srli,  "srli",  InstructionShape_RRI, 0) \
	X(Srai,  "srai",  InstructionShape_RRI, 0) \
	X(Lui,   "lui",   InstructionShape_RI,  0)
